diff --git a/src/nnue/nnue_hw.cpp b/src/nnue/nnue_hw.cpp
new file mode 100644
index 0000000..a6c1e13
--- /dev/null
+++ b/src/nnue/nnue_hw.cpp
@@ -0,0 +1,95 @@
+#include "nnue_hw.h"
+
+#if defined(USE_NNUE_HW)
+
+#include "../position.h"
+#include "nnue_architecture.h"
+#include "nnue_batch.h"
+#include "nnuehw.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <memory>
+
+namespace Stockfish {
+namespace Eval {
+namespace NNUE {
+
+namespace {
+
+class HwEvaluator {
+public:
+    HwEvaluator() {
+        auto be = std::make_unique<nnue::UIOBackend>("/dev/uio0");
+        sched_ = std::make_unique<nnue::BatchScheduler>(std::move(be));
+        ok_    = sched_->start();
+    }
+
+    ~HwEvaluator() {
+        if (sched_)
+            sched_->stop();
+    }
+
+    bool ok() const { return ok_; }
+
+    std::optional<std::pair<int, int>> evaluate(const Position& pos) {
+        if (!ok_)
+            return std::nullopt;
+
+        int  pieces = pos.count<ALL_PIECES>();
+        auto bucket = static_cast<std::uint32_t>((pieces - 1) / 4);
+
+        nnue::EvalRequest req{};
+        req.mode   = NNUEHW_DESC_MODE_REFRESH;
+        req.bucket = bucket;
+        req.side   = pos.side_to_move() == WHITE ? 0u : 1u;
+
+        uint32_t seq = sched_->enqueue(req);
+        if (seq == 0)
+            return std::nullopt;
+
+        nnue::EvalResult res;
+        if (!sched_->waitResult(seq, res, 2000))
+            return std::nullopt;
+        if (res.status != NNUEHW_RESULT_OK)
+            return std::nullopt;
+
+        return std::make_pair(res.psqt, res.positional);
+    }
+
+private:
+    std::unique_ptr<nnue::BatchScheduler> sched_;
+    bool ok_ = false;
+};
+
+HwEvaluator& evaluator() {
+    static HwEvaluator hw;
+    return hw;
+}
+
+}  // anonymous namespace
+
+namespace {
+
+bool env_enabled() {
+    const char* e = std::getenv("NNUE_HW");
+    return e && e[0] == '1';
+}
+
+}  // anonymous namespace
+
+bool hw_enabled() {
+    return env_enabled() && evaluator().ok();
+}
+
+std::optional<std::pair<int, int>> evaluate_hw(const Position& pos) {
+    if (!hw_enabled())
+        return std::nullopt;
+    return evaluator().evaluate(pos);
+}
+
+}  // NNUE
+}  // Eval
+}  // Stockfish
+
+#endif  // USE_NNUE_HW
