+++ b/src/nnue/nnue_hw.h
@@ -0,0 +1,28 @@
+/*
+ * nnue_hw.h — SF18 evaluate_hw 라우팅 (M4-SW)
+ *
+ * USE_NNUE_HW 빌드 플래그 + NNUE_HW 런타임 env 로 HW 경로 활성화.
+ * HW 미가동 시 evaluate_hw() 가 nullopt 를 반환 → 기존 SW eval 로 fallback.
+ */
+#ifndef NNUE_HW_H
+#define NNUE_HW_H
+
+#if defined(USE_NNUE_HW)
+
+#include <optional>
+#include <utility>
+
+namespace Stockfish {
+class Position;
+namespace Eval {
+namespace NNUE {
+
+bool hw_enabled();
+std::optional<std::pair<int, int>> evaluate_hw(const Position& pos);
+
+}
+}
+}
+
+#endif  // USE_NNUE_HW
+#endif  // NNUE_HW_H
