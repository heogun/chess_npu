# Added to socfpga_defconfig: what systemd needs, plus the PMU for perf on the Cortex-A9.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_AUTOFS_FS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=n
CONFIG_SECCOMP=y
CONFIG_DMIID=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_LOCALVERSION="-chessnpu"
CONFIG_LOCALVERSION_AUTO=n
