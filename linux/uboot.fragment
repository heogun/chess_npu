# Added to socfpga_de1_soc_defconfig. u-boot-with-spl.sfp holds 4 SPL copies of 64 KiB, then
# u-boot.img, so U-Boot proper is 0x200 sectors into the a2 partition. The partition starts at sector
# 0x800 in tools/make-sd-image.sh, which puts U-Boot at absolute sector 0xa00.
# The upstream default of 0x200 only fits an image written at sector 0 without an MBR.
# SECTOR depends on USE_SECTOR in common/spl/Kconfig, so the partition modes cannot use it.
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_SECTOR=y
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0xa00
# The defconfig leaves bootcmd empty, so U-Boot would stop at its prompt.
# If /boot/fpga/board.rbf exists on the root partition and loads (MSEL must be 00000, FPP x16,
# uncompressed .rbf), the bridges and F2SDRAM ports are enabled and fpga_bootargs=mem=768M is set;
# extlinux.conf appends ${fpga_bootargs}, so only FPGA boots keep the top 256 MiB from Linux.
# Without the file, or if loading fails, this is the plain CPU-only boot with all 1 GiB.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if load mmc 0:2 ${kernel_addr_r} /boot/fpga/board.rbf; then if fpga load 0 ${kernel_addr_r} ${filesize}; then bridge enable; setenv fpga_bootargs mem=768M; echo FPGA loaded, bridges enabled, mem=768M; else echo FPGA load failed, CPU-only boot; fi; else echo No FPGA image, CPU-only boot; fi; run distro_bootcmd"
