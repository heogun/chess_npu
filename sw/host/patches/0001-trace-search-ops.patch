+// Trace of search operations for hardware regression. Writes only when SF_TRACE_FILE is set
+// and never feeds anything back into the search.
+namespace {
+std::FILE* trace_stream() {
+    static std::FILE* f = [] {
+        const char* path = std::getenv("SF_TRACE_FILE");
+        return path ? std::fopen(path, "wb") : nullptr;
+    }();
+    return f;
+}
+
+void trace_op(std::uint32_t type, std::uint32_t a, std::int32_t b) {
+    if (std::FILE* f = trace_stream())
+    {
+        const std::int32_t rec[3] = {std::int32_t(type), std::int32_t(a), b};
+        std::fwrite(rec, sizeof(rec), 1, f);
+    }
+}
+}
