# Files that run inside Linux (WSL or the board) keep LF on every checkout.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.patch text eol=lf
*.fragment text eol=lf
*.dts text eol=lf
# Docs and lint config are LF as stored. Serial logs (*.txt) are not listed: they keep the
# board's CR bytes as recorded.
*.md text eol=lf
*.json text eol=lf
